VERIDASH_WORKER_DATABASE_URL=postgresql+asyncpg://{{ veridash_database_user }}:{{ vault_veridash_database_password | urlencode }}@127.0.0.1/{{ veridash_database_name }}
VERIDASH_WORKER_DATA_ROOT=/var/lib/veridash
VERIDASH_WORKER_FFMPEG_FINGERPRINT={{ veridash_ffmpeg_fingerprint }}
VERIDASH_WORKER_TRANSCRIPTION_MODEL_PATH={{ veridash_transcription_model_path }}
VERIDASH_WORKER_TRANSCRIPTION_DEVICE={{ 'cuda' if veridash_enable_gpu_worker else 'auto' }}
VERIDASH_WORKER_TRANSCRIPTION_COMPUTE_TYPE={{ 'float16' if veridash_enable_gpu_worker else 'default' }}
