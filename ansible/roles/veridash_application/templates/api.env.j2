VERIDASH_DATABASE_URL=postgresql+asyncpg://{{ veridash_database_user }}:{{ vault_veridash_database_password | urlencode }}@127.0.0.1:{{ veridash_database_port }}/{{ veridash_database_name }}
VERIDASH_DATA_ROOT=/var/lib/veridash
VERIDASH_SESSION_COOKIE_SECURE=true
VERIDASH_SESSION_TTL_SECONDS={{ veridash_session_ttl_seconds }}
VERIDASH_MAX_UPLOAD_BYTES={{ veridash_max_upload_bytes }}
VERIDASH_FFMPEG_FINGERPRINT={{ veridash_ffmpeg_fingerprint }}
